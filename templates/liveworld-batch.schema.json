{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mart123z.github.io/LiveWorld/templates/liveworld-batch.schema.json",
  "title": "LiveWorld — lot d'import (batch) v1",
  "description": "Fichier produit par Claude après une session de veille, importé dans le site LiveWorld. Toutes les opérations sont additives : un lot n'efface jamais ce qui existe.",
  "type": "object",
  "required": ["schema", "generated_at", "events"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "liveworld.batch/v1" },
    "batch_id": { "type": "string", "description": "Identifiant unique du lot. Recommandé : 'AAAA-MM-JJTHH-MM-claude'. Généré automatiquement s'il est absent." },
    "generated_at": { "type": "string", "format": "date-time", "description": "Date-heure ISO 8601 de production du lot, avec fuseau (ex. 2026-11-26T09:30:00+01:00)." },
    "author": { "type": "string", "default": "claude" },
    "request": { "type": "string", "description": "Résumé en une phrase de la demande de l'utilisateur pour cette session." },
    "coverage": {
      "type": "object",
      "properties": {
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" },
        "focus": { "type": "string" }
      }
    },
    "notes": { "type": "string", "description": "Remarques de Claude sur la session : limites, sujets non couverts, sources inaccessibles." },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "briefing": { "$ref": "#/$defs/briefing" },
    "markets": { "type": "array", "items": { "$ref": "#/$defs/market" } }
  },
  "$defs": {
    "eventId": { "type": "string", "pattern": "^evt-[0-9]{8}-[a-z0-9]+(-[a-z0-9]+)*$", "description": "evt-AAAAMMJJ-slug : date de DÉBUT de l'événement + 2 à 6 mots en kebab-case ASCII. Stable pour toujours." },
    "event": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/eventId" },
        "title": { "type": "string", "maxLength": 120 },
        "summary": { "type": "string", "maxLength": 1200, "description": "Synthèse factuelle à jour, 2 à 5 phrases." },
        "date": { "type": "string", "format": "date", "description": "Date de début (AAAA-MM-JJ). Obligatoire pour un nouvel événement." },
        "status": { "enum": ["active", "monitoring", "resolved"] },
        "ended_on": { "type": "string", "format": "date" },
        "severity": { "enum": ["critical", "high", "moderate"] },
        "themes": { "type": "array", "items": { "enum": ["conflits-securite", "diplomatie", "politique-interieure", "banques-centrales", "macroeconomie", "marches", "energie", "matieres-premieres", "logistique-commerce", "tech-semis", "cyber", "catastrophes-climat", "sante", "social"] }, "minItems": 1, "maxItems": 3 },
        "tags": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 12 },
        "location": {
          "type": "object",
          "required": ["name", "lat", "lng"],
          "properties": {
            "name": { "type": "string" },
            "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 },
            "precision": { "enum": ["exact", "city", "region", "country", "sea"] }
          }
        },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at", "text"],
            "properties": {
              "at": { "type": "string", "description": "Date-heure ISO (ou date seule) du fait rapporté." },
              "text": { "type": "string", "maxLength": 400 },
              "severity": { "enum": ["critical", "high", "moderate"] },
              "source_url": { "type": "string", "pattern": "^https://" }
            }
          }
        },
        "impacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sector", "direction", "rationale"],
            "properties": {
              "sector": { "type": "string" },
              "direction": { "enum": ["bullish", "bearish", "volatile"] },
              "horizon": { "enum": ["days", "weeks", "months"] },
              "confidence": { "enum": ["low", "medium", "high"] },
              "rationale": { "type": "string", "maxLength": 300 }
            }
          }
        },
        "parents": { "type": "array", "items": { "$ref": "#/$defs/eventId" }, "description": "Événements qui sont des causes directes (raccourci pour des liens de type 'causes')." },
        "related": { "type": "array", "items": { "$ref": "#/$defs/eventId" } },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "merge_into": { "$ref": "#/$defs/eventId", "description": "Rarement utilisé : signale que cet événement est un doublon d'un autre et doit y être fusionné." }
      }
    },
    "source": {
      "type": "object",
      "required": ["outlet", "url", "published_at"],
      "properties": {
        "outlet": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" },
        "published_at": { "type": "string", "description": "Date-heure ISO de publication (ou date seule si l'heure est inconnue)." },
        "lang": { "type": "string" }
      }
    },
    "link": {
      "type": "object",
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "$ref": "#/$defs/eventId" },
        "to": { "$ref": "#/$defs/eventId" },
        "type": { "enum": ["causes", "escalates", "responds_to", "follows", "relates_to"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "rationale": { "type": "string", "maxLength": 300 }
      }
    },
    "briefing": {
      "type": "object",
      "required": ["date"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "top": { "type": "array", "maxItems": 5, "items": { "type": "object", "required": ["event_id", "why"], "properties": { "event_id": { "$ref": "#/$defs/eventId" }, "why": { "type": "string" } } } },
        "macro": { "type": "string" },
        "markets": { "type": "string" },
        "watch": { "type": "array", "items": { "type": "string" } },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "market": {
      "type": "object",
      "required": ["date", "asset", "close"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "asset": { "type": "string", "description": "SPX, CAC40, XAU, BRENT, EURUSD, BTC, US10Y, ou autre code court." },
        "close": { "type": "number" },
        "change_pct": { "type": "number", "description": "Variation du jour en %. Pour US10Y, variation en points de base." },
        "source_url": { "type": "string", "pattern": "^https://" }
      }
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "type": "string", "description": "Optionnel. Renvoyer un bloc avec le même id le REMPLACE (utile pour des chiffres clés mis à jour)." },
        "type": { "enum": ["text", "callout", "key_figures", "table", "chart", "timeline", "diagram", "scenarios", "links", "image", "quote", "map_points"] }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "text" } } }, "then": { "required": ["md"] } },
        { "if": { "properties": { "type": { "const": "callout" } } }, "then": { "required": ["md"], "properties": { "tone": { "enum": ["info", "warning", "critical", "positive"] } } } },
        { "if": { "properties": { "type": { "const": "key_figures" } } }, "then": { "required": ["items"] } },
        { "if": { "properties": { "type": { "const": "table" } } }, "then": { "required": ["columns", "rows"] } },
        { "if": { "properties": { "type": { "const": "chart" } } }, "then": { "required": ["chart", "labels", "series"], "properties": { "chart": { "enum": ["bar", "line"] } } } },
        { "if": { "properties": { "type": { "const": "timeline" } } }, "then": { "required": ["items"] } },
        { "if": { "properties": { "type": { "const": "diagram" } } }, "then": { "required": ["mermaid"] } },
        { "if": { "properties": { "type": { "const": "scenarios" } } }, "then": { "required": ["items"] } },
        { "if": { "properties": { "type": { "const": "links" } } }, "then": { "required": ["items"] } },
        { "if": { "properties": { "type": { "const": "image" } } }, "then": { "required": ["url", "alt", "credit", "license", "source_url"] } },
        { "if": { "properties": { "type": { "const": "quote" } } }, "then": { "required": ["text", "author", "source_url"] } },
        { "if": { "properties": { "type": { "const": "map_points" } } }, "then": { "required": ["points"] } }
      ]
    }
  }
}
